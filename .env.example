# =============================================================================
# RCCG Grace Tabernacle - Environment Variables Template
# =============================================================================
# Copy this file to .env.local for development or configure in your deployment platform

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NEXT_PUBLIC_APP_NAME="RCCG Grace Tabernacle"
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NEXT_PUBLIC_APP_ENV="production"

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Prayer Request API
NEXT_PUBLIC_PRAYER_API_URL="/api/prayer"

# External APIs (if needed)
# NEXT_PUBLIC_EXTERNAL_API_URL=""
# EXTERNAL_API_KEY=""

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================
# Payment Gateway (Paystack, Stripe, etc.)
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
# PAYSTACK_SECRET_KEY=""

# Email Service (for notifications)
# EMAIL_SERVICE_API_KEY=""
# EMAIL_FROM_ADDRESS=""

# Analytics (Google Analytics, etc.)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# CSRF Protection
NEXTAUTH_SECRET="your-nextauth-secret-key-here"
NEXTAUTH_URL="https://your-domain.com"

# Rate Limiting
# RATE_LIMIT_MAX_REQUESTS="100"
# RATE_LIMIT_WINDOW_MS="900000"

# =============================================================================
# PERFORMANCE & MONITORING
# =============================================================================
# Sentry (Error Monitoring)
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""

# Vercel Analytics
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""

# =============================================================================
# CONTENT MANAGEMENT
# =============================================================================
# CMS Configuration (if using headless CMS)
# CMS_API_URL=""
# CMS_API_TOKEN=""

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================
# Debug flags (only for development)
# NEXT_PUBLIC_DEBUG_MODE="false"
# NEXT_PUBLIC_SHOW_PERFORMANCE_METRICS="false"